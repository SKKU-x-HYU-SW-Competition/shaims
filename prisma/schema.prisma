generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTICIPANT
}

model User {
  id                  String          @id @default(cuid())
  teamName            String          @unique
  passwordHash        String
  role                Role            @default(PARTICIPANT)
  createdAt           DateTime        @default(now())
  groupId             String?
  group               Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  submissions         Submission[]
  homeMatches         GroupMatch[]    @relation("GroupHome")
  awayMatches         GroupMatch[]    @relation("GroupAway")
  knockoutHomeMatches KnockoutMatch[] @relation("KOHome")
  knockoutAwayMatches KnockoutMatch[] @relation("KOAway")

  @@index([groupId])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  language  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Group {
  id        String       @id @default(cuid())
  name      String       @unique
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  users     User[]
  matches   GroupMatch[]
}

model GroupMatch {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeUserId String
  homeUser   User      @relation("GroupHome", fields: [homeUserId], references: [id], onDelete: Cascade)
  awayUserId String
  awayUser   User      @relation("GroupAway", fields: [awayUserId], references: [id], onDelete: Cascade)
  homeScore  Int?
  awayScore  Int?
  playedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([groupId])
  @@index([homeUserId])
  @@index([awayUserId])
}

model KnockoutMatch {
  id           String    @id @default(cuid())
  round        Int
  slot         Int
  isThirdPlace Boolean   @default(false)
  homeUserId   String?
  homeUser     User?     @relation("KOHome", fields: [homeUserId], references: [id], onDelete: SetNull)
  awayUserId   String?
  awayUser     User?     @relation("KOAway", fields: [awayUserId], references: [id], onDelete: SetNull)
  homeScore    Int?
  awayScore    Int?
  playedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([round, slot, isThirdPlace])
  @@index([homeUserId])
  @@index([awayUserId])
}
